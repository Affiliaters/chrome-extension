{
  "manifest_version": 3,
  "name": "Affiliaters Deal Converter",
  "version": "0.0.5",
  "description": "Convert deals using Affiliaters",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.flipkart.com/*",
    "https://*.myntra.com/*",
    "https://*.amazon.in/*",
    "https://*.croma.com/*",
    "https://*.shopsy.in/*",
    "https://app.affiliaters.in/*",
    "https://app-api.affiliaters.in/*",
    "https://ek.affiliaters.in/*",
    "https://ekaro-api.affiliaters.in/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.flipkart.com/*",
        "https://*.myntra.com/*",
        "https://*.amazon.in/*",
        "https://*.croma.com/*",
        "https://*.shopsy.in/*"
      ],
      "css": [
        "content-styles.css"
      ],
      "js": [
        "config.js",
        "storage.js",
        "floating-drag.js",
        "content.js"
      ]
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "css": [
        "content-styles.css"
      ],
      "js": [
        "config.js",
        "storage.js",
        "floating-drag.js",
        "telegram.js"
      ]
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "telegram-visibility.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "content-styles.css"
      ],
      "js": [
        "config.js",
        "storage.js",
        "floating-drag.js",
        "whatsapp-listener.js"
      ]
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-visibility.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "images/icon.png"
  }
}
